{#
| Variable | Type | Description |
|---|---|---|
| component.products | Product[] | single selected product |
| component.mini_1 | ?string | |
| component.all_text / all_url | ?string | |
#}
{% set product = component.products|first %}
{% set mini1 = component.mini_1 ?: trans('blocks.tos.feat_ship') %}
{% set all_text = component.all_text ?: trans('blocks.tos.feat_all') %}
{% if product %}
<div class="tos" lang="{{ language.code }}" dir="{{ theme.is_rtl ? 'rtl' : 'ltr' }}">
<section component-id="{{ componentId }}" data-testid="store-home-tos-featured" class="feat b-white band">
  <div class="wrap">
    <div class="gal">
      <div class="big"><img src="{{ product.image.url }}" alt="{{ product.image.alt ?: product.name }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:inherit"></div>
      {% for image in product.images|slice(1, 2) %}
        <div class="sm"><img src="{{ image.url }}" alt="{{ image.alt ?: product.name }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:inherit"></div>
      {% endfor %}
    </div>
    <div>
      <h2><a href="{{ product.url }}">{{ product.name }}</a></h2>
      {% if product.subtitle %}<p>{{ product.subtitle }}</p>{% endif %}
      <div class="mini"><div><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"></path><circle cx="7" cy="17" r="1.8"></circle><circle cx="17" cy="17" r="1.8"></circle></svg>{{ mini1 }}</div></div>
      <div class="acts">
        <salla-add-product-button
          data-testid="store-home-tos-featured-add"
          product-id="{{ product.id }}"
          product-status="{{ product.status }}"
          product-type="{{ product.type }}"
          amount="{{ product.base_currency_price }}"
          {{ product.is_require_shipping ? 'required-shipping' : '' }}
          class="tos-add">
          {{ product.add_to_cart_label }} · {{ product.price|money }}
        </salla-add-product-button>
        {% if component.all_url and component.all_url != '#' %}<a class="btn alt" href="{{ component.all_url }}">{{ all_text }}</a>{% else %}<a class="btn alt" href="{{ product.url }}">{{ trans('blocks.tos.feat_view') }}</a>{% endif %}
      </div>
    </div>
  </div>
</section>
</div>
{% endif %}
